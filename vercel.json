{
  "version": 2,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*\\.png)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*\\.webp)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*\\.svg)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "https://facelook-backend.onrender.com/sitemap.xml"
    },
    {
      "source": "/api/(.*)",
      "destination": "https://facelook-backend.onrender.com/api/$1"
    },
    {
      "source": "/admin",
      "destination": "/client/admin.html"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/client/assets/$1"
    },
    {
      "source": "/(.*\\.png)",
      "destination": "/client/$1"
    },
    {
      "source": "/(.*\\.webp)",
      "destination": "/client/$1"
    },
    {
      "source": "/(.*\\.js)",
      "destination": "/client/$1"
    },
    {
      "source": "/(.*\\.css)",
      "destination": "/client/$1"
    },
    {
      "source": "/(.*\\.svg)",
      "destination": "/client/$1"
    },
    {
      "source": "/(.*\\.jpg)",
      "destination": "/client/$1"
    },
    {
      "source": "/(.*\\.jpeg)",
      "destination": "/client/$1"
    },
    {
      "source": "/(.*\\.gif)",
      "destination": "/client/$1"
    },
    {
      "source": "/(.*\\.ico)",
      "destination": "/client/$1"
    },
    {
      "source": "/robots.txt",
      "destination": "/client/robots.txt"
    },
    {
      "source": "/(.*)",
      "destination": "/client/index.html"
    }
  ]
}
