{
  "version": 2,
  "builds": [
    {
      "src": "server/server.js",
      "use": "@vercel/node"
    },
    {
      "src": "index.html.html",
      "use": "@vercel/static"
    },
    {
      "src": "client/**",
      "use": "@vercel/static"
    },
    {
      "src": "*.webp",
      "use": "@vercel/static"
    },
    {
      "src": "*.png",
      "use": "@vercel/static"
    },
    {
      "src": "*.svg",
      "use": "@vercel/static"
    },
    {
      "src": "robots.txt",
      "use": "@vercel/static"
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "https://facelook-backend.onrender.com/sitemap.xml"
    },
    {
      "source": "/robots.txt",
      "destination": "/robots.txt"
    },
    {
      "source": "/api/(.*)",
      "destination": "https://facelook-backend.onrender.com/api/$1"
    },
    {
      "source": "/admin",
      "destination": "/client/admin.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html.html"
    }
  ]
}