{
  "version": 2,
  "builds": [
    {
      "src": "server/server.js",
      "use": "@vercel/node"
    },
    { "src": "index.html.html", "use": "@vercel/static" },
    { "src": "client/**", "use": "@vercel/static" },
    { "src": "*.webp", "use": "@vercel/static" },
    { "src": "*.png", "use": "@vercel/static" }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/server/server.js" },
    { "source": "/admin", "destination": "/client/admin.html" },
    { "source": "/(.*)", "destination": "/index.html.html" }
  ]
}